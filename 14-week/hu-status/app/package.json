{
  "name": "w14-academic-connect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Week 14 - Ionic React + Capacitor app with camera, token login, offline handling and unit tests.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run",
    "test.watch": "vitest",
    "measure": "vitest run src/__tests__/optimization.measure.test.tsx --reporter=verbose",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@ionic/react": "^9.0.0",
    "@ionic/react-router": "^9.0.0",
    "ionicons": "^8.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.0.0",
    "vitest": "~4.0.18"
  }
}
